# Dependencies
node_modules/
.pnp
.pnp.js

# Lockfiles — intentionally NOT committed on this project (matches root and
# every workspace, e.g. apps/web-portal). See the PR note for the rationale.
package-lock.json

# Env / secrets — never commit real values
.env
.env.local
.env.*.local
!.env.example

# Build output
dist/
build/
.next/
out/

# Vercel CLI project link (apps/web-portal has its own; this one lets the
# CLI resolve the project's Root Directory setting correctly when deploying
# from the monorepo root instead of from inside apps/web-portal)
.vercel

# Prisma
prisma/*.db
prisma/migrations/dev.db

# React Native / Expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
ios/Pods/
ios/build/
android/app/build/
android/.gradle/
*.hprof

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Testing / coverage
coverage/

# Claude Code local state (keep .claude/agents, ignore local session cache)
.claude/local/